package db;

import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.SQLException;

/**
 * Step5 データベース接続を管理するクラス(接続処理を共通化する)
 * DAO からは DBManager.getConnection() で接続を取得する(static メソッドなので クラス名.メソッド名 で呼ぶ)
 * 接続は DAO 側の try-with-resources で自動的に閉じる
 *
 * 【使い方】このファイルを DBManager.java という名前で同じフォルダ(db)にコピーし、
 *           HOST_NAME・SERVICE_NAME・USER・PASSWORD を書き換える
 *           (DBManager.java は .gitignore で GitHub に上げないようにしている)
 * JDBCドライバ: ojdbc17.jar(JDK25 用)を src/main/webapp/WEB-INF/lib にコピーする
 */
public class DBManager {

    // データベース接続情報
    private static final String HOST_NAME    = "ホスト名";
    private static final String PORT_NO      = "1521";
    private static final String SERVICE_NAME = "サービス名";
    private static final String USER         = "ユーザー名";
    private static final String PASSWORD     = "パスワード";

    // JDBC接続URL
    private static final String URL =
            "jdbc:oracle:thin:@" + HOST_NAME + ":" + PORT_NO + "/" + SERVICE_NAME;

    /**
     * データベースに接続する
     *
     * @return データベース接続情報
     * @throws SQLException データベース接続エラー
     */
    public static Connection getConnection() throws SQLException {
        try {
            // Oracle JDBCドライバを明示的に読み込む
            Class.forName("oracle.jdbc.OracleDriver");
        } catch (ClassNotFoundException e) {
            // ドライバJARが見つからない場合
            throw new SQLException(
                    "Oracle JDBCドライバが見つかりません。"
                            + "ojdbc17.jarの配置を確認してください。", e);
        }
        // Oracleデータベースに接続してConnectionを返す
        return DriverManager.getConnection(URL, USER, PASSWORD);
    }
}
